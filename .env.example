# 这是模板：`cp .env.example .env` 之后把值填上。`.env` 不入库，也不进镜像。
#
# 注意：**空值不等于"用默认值"**。代码里是 `process.env.X ?? 默认值`，空串会把默认值顶掉。
# 所以凡是"不给就用默认"的项，下面一律注释掉；没注释的必须填。
#
# 另：这个文件只支持**整行注释**（以 `#` 开头的行），行尾的 `#` 会被当成值的一部分。

# ── chat / 修订用的模型端点（OpenAI 兼容）──────────────────────────────
MIGHT_CHAT_API_KEY=
MIGHT_CHAT_API_BASE_URL=https://example.invalid/v1
# MIGHT_CHAT_MODEL=              # 不给则用代码里的默认（见 docs/brains.md 的配置表）

# ── STT / TTS（OpenAI 兼容；baseURL 底下拼 /audio/transcriptions 和 /audio/speech）
# 下面两个地址是 RFC 5737 的文档段，换成你自己的；通常要带 /v1。
STT_API_KEY=
STT_API_BASE_URL=http://192.0.2.113:8082/v1
# STT_MODEL=qwen-asr             # 不给则用这个默认值

TTS_API_KEY=
TTS_API_BASE_URL=http://192.0.2.102:6677/v1
# TTS_MODEL=moss-tts             # 不给则用这个默认值
# 默认音色：必填。名字看 TTS 服务认什么，不是 OpenAI 那套（alloy / nova / …）。
TTS_VOICE=
# 分句服务（wtpsplit-lite）。compose 里就是下面这个内网地址；流式回复硬依赖它。
WTP_SPLIT_URL=http://wtpsplit:8000/split

# ── brains 自己 ──────────────────────────────────────────────────────
# MIGHT_BRAINS_TOKEN 留空 = 不启用鉴权
MIGHT_BRAINS_TOKEN=
MIGHT_BRAINS_PORT=8787
MIGHT_BRAINS_POLL_TIMEOUT_MS=25000
